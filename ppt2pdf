#!/bin/bash

# A script to convert all PPT/PPTX files in a directory to PDF using LibreOffice

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=======================================${NC}"
echo -e "${BLUE}      PPT/PPTX to PDF Converter        ${NC}"
echo -e "${BLUE}=======================================${NC}"

# Check dependencies
if ! command -v libreoffice &> /dev/null; then
    echo -e "${RED}Error: 'libreoffice' is not installed or not in PATH.${NC}"
    echo -e "Please install it using your package manager (e.g., sudo apt install libreoffice)."
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo -e "${YELLOW}Usage:${NC} $0 <directory_path>"
    echo -e "Example: $0 ./my_presentations"
    exit 1
fi

INPUT_DIR="$1"

if [ ! -d "$INPUT_DIR" ]; then
    echo -e "${RED}Error: Directory '$INPUT_DIR' does not exist.${NC}"
    exit 1
fi

echo -e "Scanning directory: ${YELLOW}$INPUT_DIR${NC} for .ppt and .pptx files..."

# Find all PPT/PPTX files
# We use an array to handle filenames with spaces correctly
mapfile -d '' files < <(find "$INPUT_DIR" -maxdepth 1 -type f \( -iname "*.ppt" -o -iname "*.pptx" \) -print0)

if [ ${#files[@]} -eq 0 ]; then
    echo -e "${YELLOW}No .ppt or .pptx files found in the specified directory.${NC}"
    exit 0
fi

echo -e "Found ${GREEN}${#files[@]}${NC} files to convert."
echo -e "Starting conversion...\n"

success_count=0
fail_count=0

for file in "${files[@]}"; do
    filename=$(basename "$file")
    echo -e "Converting: ${YELLOW}$filename${NC} ..."
    
    # Run LibreOffice headless conversion
    if libreoffice --headless --convert-to pdf "$file" --outdir "$INPUT_DIR" > /dev/null 2>&1; then
        echo -e "${GREEN}✓ Success:${NC} $filename -> PDF"
        ((success_count++))
    else
        echo -e "${RED}✗ Failed:${NC} $filename"
        ((fail_count++))
    fi
done

echo -e "\n${BLUE}=======================================${NC}"
echo -e "Conversion complete!"
echo -e "Successfully converted: ${GREEN}$success_count${NC}"
if [ $fail_count -gt 0 ]; then
    echo -e "Failed conversions: ${RED}$fail_count${NC}"
fi
echo -e "${BLUE}=======================================${NC}"
